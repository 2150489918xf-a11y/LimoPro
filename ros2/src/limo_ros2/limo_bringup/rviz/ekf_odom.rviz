Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Offset: {X: 0, Y: 0, Z: -0.2}
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Flat Squares
      Size (m): 0.03
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 80; 200; 255
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Name: EKF Odometry (green)
      Enabled: true
      Value: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 20
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 300
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 30; 255; 80
        Alpha: 1
        Shaft Length: 0.25
        Shaft Radius: 0.015
        Head Length: 0.1
        Head Radius: 0.04
    - Class: rviz_default_plugins/Odometry
      Name: Raw Odometry (orange)
      Enabled: true
      Value: true
      Topic:
        Value: /odom/raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 20
      Position Tolerance: 0.05
      Angle Tolerance: 0.05
      Keep: 300
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Color: 255; 150; 30
        Alpha: 0.65
        Shaft Length: 0.18
        Shaft Radius: 0.01
        Head Length: 0.07
        Head Radius: 0.03
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 7
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 1.2
      Yaw: 4.7
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Width: 1500
  Height: 900
  X: 0
  Y: 40
